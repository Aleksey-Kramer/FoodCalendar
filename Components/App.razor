@using FoodCalendar.Services
<!DOCTYPE html>
<html lang="@_lang" data-theme="@_theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6366f1" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" Lang="@_lang" IsAdmin="@_isAdmin" />
    <script src="app.js"></script>
    <script src="dropzone.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Язык и тема хранятся в cookie, чтобы уже предрендер шёл на нужном языке и без мигания темы.
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    [Inject] public AdminAuth Auth { get; set; } = default!;

    private string _lang = "ru";
    private string? _theme;
    private bool _isAdmin;

    protected override void OnInitialized()
    {
        var cookies = HttpContext?.Request.Cookies;
        _lang = I18n.Normalize(cookies?[I18n.CookieName]);
        var theme = cookies?["fc.theme"];
        _theme = theme is "light" or "dark" ? theme : null;
        // cookie администратора проверяется подписью; параметры корневого компонента защищены Blazor от подмены
        _isAdmin = Auth.IsValid(cookies?[AdminAuth.CookieName]);
    }
}
