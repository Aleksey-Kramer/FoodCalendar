@page "/people"
@inject PeopleService PeopleSvc
@inject I18n L

<PageTitle>@L["nav.people"]</PageTitle>

<div class="page-head">
    <h1>@L["nav.people"]</h1>
</div>
<p class="muted">@L["people.hint"]</p>

<form class="inline-form" @onsubmit="Add" @onsubmit:preventDefault="true">
    <input class="input" @bind="_name" maxlength="60" placeholder="@L["people.name"]" />
    <button type="submit" class="btn btn--primary" disabled="@_busy">@L["ui.add"]</button>
</form>
@if (_error is not null)
{
    <div class="alert">@_error</div>
}

@if (_list is null)
{
    <p class="muted">@L["ui.loading"]</p>
}
else if (_list.Count == 0)
{
    <p class="muted">@L["people.empty"]</p>
}
else
{
    <ul class="rlist">
        @foreach (var p in _list)
        {
            <li class="rlist__item">
                <div class="rlist__name">@p.Name</div>
                <div class="rlist__actions">
                    @if (_confirmId == p.Id)
                    {
                        <span class="confirm">
                            @L["ui.sure"]
                            <button type="button" class="btn btn--sm btn--danger" @onclick="() => Delete(p.Id)">@L["ui.yes"]</button>
                            <button type="button" class="btn btn--sm" @onclick="() => _confirmId = null">@L["ui.no"]</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="btn btn--sm btn--danger" @onclick="() => _confirmId = p.Id">@L["ui.delete"]</button>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<Person>? _list;
    private string _name = "";
    private string? _error;
    private bool _busy;
    private long? _confirmId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _list = await PeopleSvc.GetAllAsync();

    private async Task Add()
    {
        _busy = true;
        _error = null;
        try
        {
            await PeopleSvc.GetOrCreateAsync(_name);
            _name = "";
            await LoadAsync();
        }
        catch (ValidationException ex)
        {
            _error = L.Error(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Delete(long id)
    {
        await PeopleSvc.DeleteAsync(id);
        _confirmId = null;
        await LoadAsync();
    }
}
