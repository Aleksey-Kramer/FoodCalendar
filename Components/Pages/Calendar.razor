@page "/"
@inject CalendarService CalendarSvc
@inject MealService Meals
@inject RestaurantService RestaurantSvc
@inject PeopleService PeopleSvc
@inject ChangeNotifier Notifier
@inject I18n L
@inject AdminSession Session
@implements IDisposable

<PageTitle>@L["app.title"]</PageTitle>

<div class="cal-toolbar">
    <div class="cal-nav">
        <button type="button" class="btn btn--icon" @onclick="PrevMonth" title="@L["cal.prevMonth"]" aria-label="@L["cal.prevMonth"]">‹</button>
        <h1 class="cal-title">@(_grid is null ? "…" : L.MonthTitle(_year, _month))</h1>
        <button type="button" class="btn btn--icon" @onclick="NextMonth" title="@L["cal.nextMonth"]" aria-label="@L["cal.nextMonth"]">›</button>
    </div>
    <button type="button" class="btn" @onclick="GoToday">@L["ui.today"]</button>
</div>

@if (_grid is null)
{
    <p class="muted">@L["ui.loading"]</p>
}
else
{
    <div class="cal">
        <div class="cal-weekdays">
            @for (var i = 0; i < 7; i++)
            {
                <div class="cal-weekday @(i >= 5 ? "cal-weekday--weekend" : "")">@L.WeekdayHeaders[i]</div>
            }
        </div>
        @for (var w = 0; w < _grid.Weeks.Count; w++)
        {
            var week = _grid.Weeks[w];
            var weekIndex = w;
            <div class="cal-week">
                @for (var c = 0; c < 7; c++)
                {
                    var day = week[c];
                    var cls = CellClass(day);
                    <div class="cal-cellwrap">
                    @if (day.IsWeekend)
                    {
                        <div class="@cls" aria-disabled="true" title="@L["cal.dayOff"]">
                            <span class="cal-daynum">@day.Date.Day</span>
                            <span class="cal-off">@L["cal.dayOffLower"]</span>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="@cls" @onclick="() => OpenDialog(day)">
                            <span class="cal-daynum">@day.Date.Day</span>
                            @if (day.Main is { } m)
                            {
                                <RestaurantThumb Name="@m.RestaurantName" ImageFile="@m.ImageFile" CssClass="thumb--cell" />
                                <span class="cal-rname">@m.RestaurantName</span>
                            }
                            else
                            {
                                <span class="cal-empty">+</span>
                            }
                            @if (day.ExtrasCount > 0 || day.HasReceipt)
                            {
                                <span class="cal-badges">
                                    @if (day.ExtrasCount > 0) { <span class="cal-badge" title="@L["cal.extras"]">+@day.ExtrasCount</span> }
                                    @if (day.HasReceipt) { <span class="cal-badge cal-badge--receipt" title="@L["cal.hasReceipt"]">🧾</span> }
                                </span>
                            }
                        </button>
                        @if (_details.TryGetValue(day.Date, out var det) && det.All.Any(x => x.HasReceiptData))
                        {
                            <div class="tip @(c >= 4 ? "tip--left" : "") @(weekIndex >= 3 ? "tip--up" : "")">
                                <div class="tip__card">
                                    <div class="tip__date">@L.DateLong(day.Date)</div>
                                    @if (det.Main is { } mm)
                                    {
                                        <div class="tip__meal tip__main">
                                            <div class="tip__title">
                                                <b>@mm.RestaurantName</b>
                                                @if (mm.HasReceiptData) { <a class="btn btn--sm tip__view" href="/receipt/@mm.Id">@L["receipt.view"] →</a> }
                                                @if (!mm.HasReceiptData) { <span class="tip__none tip__none--always">@L["cal.noReceipt"]</span> }
                                            </div>
                                            @if (mm.HasReceiptData) { <ReceiptTip Meal="mm" /> }
                                        </div>
                                    }
                                    @if (det.Extras.Count > 0)
                                    {
                                        <div class="tip__extras">
                                            @foreach (var ex in det.Extras)
                                            {
                                                <div class="tip__extra @(ex.HasReceiptData ? "tip__extra--has" : "tip__extra--none")" @key="ex.Id">
                                                    <div class="tip__title">
                                                        <span class="chip">@ex.Label</span>
                                                        <b>@ex.RestaurantName</b>
                                                        @if (ex.HasReceiptData) { <a class="btn btn--sm tip__view" href="/receipt/@ex.Id">@L["receipt.view"] →</a> }
                                                        @if (!ex.HasReceiptData) { <span class="tip__none">@L["cal.noReceipt"]</span> }
                                                    </div>
                                                    @if (ex.HasReceiptData) { <ReceiptTip Meal="ex" /> }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    </div>
                }
            </div>
        }
    </div>
}

<VotePanel OnCompleted="LoadAsync" KnownNames="_names" />

@if (_dialogDay is { } dd)
{
    <div class="modal-backdrop" @onclick="CloseDialog">
        <div class="modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="modal__head">
                <h2>@L.DateLong(dd.Date)</h2>
                <button type="button" class="btn btn--icon" @onclick="CloseDialog" title="@L["ui.close"]" aria-label="@L["ui.close"]">✕</button>
            </div>

            @if (dd.Main is { } cur)
            {
                <p class="muted">@L["cal.main"] <b>@cur.RestaurantName</b>@(cur.IsActive ? "" : L["cal.deactivated"])</p>
            }
            else
            {
                <p class="muted">@L["cal.pickMain"]</p>
            }

            @if (_error is not null)
            {
                <div class="alert">@_error</div>
            }

            @if (!Session.IsAdmin)
            {
                <p class="muted small">🔒 @L["auth.readOnly"] <a href="/login?returnUrl=/">@L["auth.login"]</a></p>
            }
            else if (_active.Count == 0)
            {
                <p>@L["cal.noActive"] <a href="/restaurants">@L["cal.addRestaurant"]</a></p>
            }

            @if (Session.IsAdmin)
            {
            <div class="picker">
                @foreach (var r in _active)
                {
                    <button type="button"
                            class="picker__card @(dd.Main?.RestaurantId == r.Id ? "picker__card--selected" : "")"
                            disabled="@_busy"
                            @onclick="() => Assign(r.Id)">
                        <RestaurantThumb Name="@r.Name" ImageFile="@r.ImageFile" CssClass="thumb--card" />
                        <span class="picker__name">@r.Name</span>
                    </button>
                }
            </div>
            }

            <div class="modal__foot modal__foot--split">
                <a class="btn" href="/day/@CalendarService.Key(dd.Date)">@L["cal.details"]</a>
                <span class="modal__foot-right">
                    @if (dd.Main is not null && Session.IsAdmin)
                    {
                        <button type="button" class="btn btn--danger" disabled="@_busy" @onclick="Clear">@L["cal.clear"]</button>
                    }
                    <button type="button" class="btn" @onclick="CloseDialog">@L["ui.cancel"]</button>
                </span>
            </div>
        </div>
    </div>
}

@code {


    private int _year;
    private int _month;
    private MonthGrid? _grid;
    private CalendarDay? _dialogDay;
    private List<Restaurant> _active = new();
    private string? _error;
    private bool _busy;
    private List<string> _names = new();

    protected override async Task OnInitializedAsync()
    {
        var today = CalendarService.Today;
        _year = today.Year;
        _month = today.Month;
        Notifier.Changed += OnChangedAsync;
        _names = (await PeopleSvc.GetAllAsync()).Select(p => p.Name).ToList();
        await LoadAsync();
    }

    private Dictionary<DateOnly, DayDetails> _details = new();

    private async Task LoadAsync()
    {
        _grid = await CalendarSvc.BuildMonthAsync(_year, _month);
        // Детали чеков всех дней сетки — для подсказок при наведении (только CSS, без запросов на hover)
        _details = await Meals.GetRangeDetailsAsync(_grid.Weeks[0][0].Date, _grid.Weeks[^1][6].Date);
    }

    // Голосование завершилось или кто-то изменил календарь: обновляем сетку у всех открытых страниц
    private Task OnChangedAsync() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Notifier.Changed -= OnChangedAsync;

    private Task PrevMonth() => ShiftMonth(-1);

    private Task NextMonth() => ShiftMonth(1);

    private async Task ShiftMonth(int delta)
    {
        var d = new DateOnly(_year, _month, 1).AddMonths(delta);
        _year = d.Year;
        _month = d.Month;
        await LoadAsync();
    }

    private async Task GoToday()
    {
        var today = CalendarService.Today;
        _year = today.Year;
        _month = today.Month;
        await LoadAsync();
    }

    private static string CellClass(CalendarDay d)
    {
        var cls = "cal-cell";
        if (!d.InMonth) cls += " cal-cell--other";
        if (d.IsWeekend) cls += " cal-cell--weekend";
        if (d.IsToday) cls += " cal-cell--today";
        if (d.Main is not null) cls += " cal-cell--assigned";
        return cls;
    }

    private async Task OpenDialog(CalendarDay day)
    {
        if (day.IsWeekend) return;
        _error = null;
        _active = await RestaurantSvc.GetActiveAsync();
        _dialogDay = day;
    }

    private void CloseDialog()
    {
        _dialogDay = null;
        _error = null;
    }

    private async Task Assign(long restaurantId)
    {
        if (_dialogDay is null) return;
        _busy = true;
        _error = null;
        try
        {
            await Meals.AssignMainAsync(_dialogDay.Date, restaurantId);
            await LoadAsync();
            CloseDialog();
        }
        catch (ValidationException ex)
        {
            _error = L.Error(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Clear()
    {
        if (_dialogDay is null) return;
        _busy = true;
        _error = null;
        try
        {
            await Meals.ClearMainAsync(_dialogDay.Date);
            await LoadAsync();
            CloseDialog();
        }
        catch (ValidationException ex)
        {
            _error = L.Error(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
