@inject MealService Meals
@inject RestaurantService RestaurantSvc
@inject I18n L
@inject AdminSession Session

<div class="meal">
    <div class="meal__head">
        <RestaurantThumb Name="@Meal.RestaurantName" ImageFile="@Meal.ImageFile" CssClass="thumb--row" />
        <div class="meal__title">
            @if (!Meal.IsMain)
            {
                <span class="chip">@Meal.Label</span>
            }
            <b>@Meal.RestaurantName</b>
            @if (!Meal.IsActive)
            {
                <span class="badge">@L["ui.inactive"]</span>
            }
        </div>
        @if (Session.IsAdmin)
        {
        <div class="meal__actions">
            <button type="button" class="btn btn--sm" @onclick="() => OnChangeRestaurant.InvokeAsync(Meal)">@L["day.changeRestaurant"]</button>
            @if (_confirmDelete)
            {
                <span class="confirm">
                    @(Meal.IsMain && Meal.HasReceiptData
                        ? L["meal.removeMainKeep"]
                        : Meal.IsMain ? L["meal.removeMain"] : L["meal.deleteExtra"])
                    <button type="button" class="btn btn--sm btn--danger" @onclick="() => OnDelete.InvokeAsync(Meal)">@L["ui.yes"]</button>
                    <button type="button" class="btn btn--sm" @onclick="() => _confirmDelete = false">@L["ui.no"]</button>
                </span>
            }
            else
            {
                <button type="button" class="btn btn--sm btn--danger" @onclick="() => _confirmDelete = true">@(Meal.IsMain ? L["ui.remove"] : L["ui.delete"])</button>
            }
        </div>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert">@_error</div>
    }

    <div class="meal__grid">
        <div class="meal__receipt">
            <div class="field__label">@L["meal.receipt"]</div>
            @if (Meal.ReceiptFile is { } rf)
            {
                @if (ReceiptService.IsPdf(rf))
                {
                    <a class="btn btn--sm" href="@ReceiptService.Url(rf)" target="_blank">@L["meal.openPdf"]</a>
                }
                else
                {
                    <a href="@ReceiptService.Url(rf)" target="_blank" title="@L["meal.openReceipt"]">
                        <img class="receipt__img" src="@ReceiptService.Url(rf)" alt="@L["meal.receipt"]" loading="lazy" />
                    </a>
                }
                @if (Session.IsAdmin)
                {
                    <button type="button" class="btn btn--sm btn--danger" @onclick="RemoveReceipt" disabled="@_busy">@L["meal.removeReceipt"]</button>
                }
            }
            else if (Session.IsAdmin)
            {
                <label class="btn btn--sm file-btn">
                    @L["meal.attachReceipt"]
                    <InputFile OnChange="OnReceipt" accept="@ReceiptService.Accept" class="file-btn__input" />
                </label>
                <div class="muted small">@L["meal.receiptHint"]</div>
            }

            <div class="field">
                <span class="field__label">@L["meal.total"]</span>
                <div class="receipt__total" title="@L["meal.totalHint"]">@Money.Format(Meal.ItemsTotal)</div>
                @if (Meal.SharedTotal > 0)
                {
                    <div class="small muted">@L.F("meal.totalSplit", Money.Format(Meal.OwnItemsTotal), Money.Format(Meal.SharedTotal))</div>
                }
            </div>
        </div>

        <div class="meal__people">
            <div class="field__label">@L["meal.participants"]</div>
            @if (Meal.Participants.Count == 0)
            {
                <p class="muted small">@L["meal.nobody"]</p>
            }
            @foreach (var p in Meal.Participants)
            {
                var draft = DraftFor(p.Id);
                <div class="participant" @key="p.Id">
                    <div class="participant__head">
                        <b>@p.Name</b>
                        @if (Meal.SharedItems.Count > 0)
                        {
                            <span class="participant__totals">@L.F("meal.ownShared", Money.Format(p.Subtotal), Money.Format(Meal.ShareFor(p.Id)))</span>
                        }
                        <span class="participant__sum" title="@L["meal.totalWithShare"]">@Money.Format(Meal.TotalFor(p))</span>
                        @if (Session.IsAdmin)
                        {
                            <button type="button" class="pay @(p.IsPaid ? "pay--paid" : "pay--pending")" title="@L["pay.toggle"]" disabled="@_busy" @onclick="() => TogglePaid(p)">@(p.IsPaid ? "✅ " + L["pay.paid"] : "⏳ " + L["pay.pending"])</button>
                            <button type="button" class="btn btn--icon btn--xs" title="@L["meal.removeParticipant"]" @onclick="() => RemoveParticipant(p.Id)">✕</button>
                        }
                        else
                        {
                            <span class="pay @(p.IsPaid ? "pay--paid" : "pay--pending")">@(p.IsPaid ? "✅ " + L["pay.paid"] : "⏳ " + L["pay.pending"])</span>
                        }
                    </div>
                    @if (p.Items.Count > 0)
                    {
                        <table class="items">
                            <tbody>
                            @foreach (var it in p.Items)
                            {
                                <tr @key="it.Id">
                                    <td class="items__name">@it.Name</td>
                                    <td class="items__num">@Money.Format(it.Price)</td>
                                    <td class="items__num">× @it.Qty</td>
                                    <td class="items__num"><b>@Money.Format((it.Price ?? 0) * it.Qty)</b></td>
                                    <td class="items__act">@if (Session.IsAdmin) { <button type="button" class="btn btn--icon btn--xs" title="@L["meal.deleteItem"]" @onclick="() => RemoveItem(it.Id)">✕</button> }</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    @if (Session.IsAdmin)
                    {
                    <form class="inline-form inline-form--wrap" data-arrow-nav @onsubmit="() => AddItem(p.Id)" @onsubmit:preventDefault="true">
                        <SuggestInput @bind-Value="draft.Name" Items="_menuSuggest" OnPick="it => PickMenuItem(draft, it)" MaxLength="100" Placeholder="@L["meal.item"]" />
                        <MoneyInput @bind-Value="draft.Price" Placeholder="@L["ui.price"]" />
                        <input class="input input--qty" type="number" min="1" max="99" @bind="draft.Qty" title="@L["ui.qty"]" />
                        @if (!IsMenuItem(draft))
                        {
                            <label class="check small" title="@L["meal.saveToMenuHint"]"><input type="checkbox" @bind="draft.SaveToMenu" /> @L["meal.toMenu"]</label>
                        }
                        <button type="submit" class="btn btn--sm" disabled="@_busy">@L["meal.addItem"]</button>
                    </form>
                    }
                </div>
            }

            @if (Session.IsAdmin)
            {
            <form class="inline-form inline-form--wrap participant-add" data-arrow-nav @onsubmit="AddParticipant" @onsubmit:preventDefault="true">
                <SuggestInput @bind-Value="_newName" Items="_peopleSuggest" MaxLength="60" Placeholder="@L["meal.participantName"]" />
                @if (!IsKnownPerson)
                {
                    <label class="check small"><input type="checkbox" @bind="_saveToList" /> @L["meal.saveToList"]</label>
                }
                <button type="submit" class="btn btn--sm btn--primary" disabled="@_busy">@L["meal.addParticipant"]</button>
            </form>
            }
        </div>
    </div>

    <div class="shared">
        <div class="shared__head">
            <span class="field__label" style="margin:0">@L["meal.shared"]</span>
            <span class="shared__sum">@Money.Format(Meal.SharedTotal)</span>
        </div>
        @if (Meal.SharedItems.Count > 0)
        {
            <table class="items">
                <tbody>
                @foreach (var s in Meal.SharedItems)
                {
                    <tr @key="s.Id">
                        <td class="items__name">
                            @s.Name
                            <div class="shared__split">@KindTitle(s.Kind) · @SplitText(s)</div>
                        </td>
                        <td class="items__num">@(s.Qty > 1 ? $"{Money.Format(s.Price)} × {s.Qty}" : "")</td>
                        <td class="items__num"><b>@Money.Format(s.Amount)</b></td>
                        <td class="items__act">@if (Session.IsAdmin) { <button type="button" class="btn btn--icon btn--xs" title="@L["ui.delete"]" @onclick="() => RemoveShared(s.Id)">✕</button> }</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        @if (Session.IsAdmin)
        {
        <div class="quick">
            <span class="seg" role="group" aria-label="@L["meal.mode"]">
                @foreach (var mode in MealService.Modes)
                {
                    <button type="button" class="seg__btn @(Meal.Mode == mode ? "seg__btn--on" : "")" disabled="@_busy" @onclick="() => SetMode(mode)">@L[mode == "dinein" ? "meal.modeDineIn" : "meal.modeDelivery"]</button>
                }
            </span>
            @foreach (var kind in MealService.KindsFor(Meal.Mode))
            {
                <button type="button" class="btn btn--sm @(_shared.Kind == kind ? "btn--primary" : "")" @onclick="() => PickKind(kind)">@Meals.SharedKindTitle(kind)</button>
            }
        </div>
        <form class="inline-form inline-form--wrap" data-arrow-nav @onsubmit="AddShared" @onsubmit:preventDefault="true" style="margin-top:8px">
            @if (_shared.Kind == "item")
            {
                <SuggestInput @bind-Value="_shared.Name" Items="_menuSuggest" OnPick="PickSharedMenuItem" MaxLength="100" Placeholder="@L["meal.sharedPlaceholder"]" />
                <MoneyInput @bind-Value="_shared.Price" Placeholder="@L["ui.price"]" />
                <input class="input input--qty" type="number" min="1" max="99" @bind="_shared.Qty" title="@L["ui.qty"]" />
                @if (FindMenuItem(_shared.Name) is null)
                {
                    <label class="check small" title="@L["meal.saveToMenuHint"]"><input type="checkbox" @bind="_shared.SaveToMenu" /> @L["meal.toMenu"]</label>
                }
            }
            else
            {
                <input class="input input--grow" @bind="_shared.Name" maxlength="100" placeholder="@KindTitle(_shared.Kind)" />
                <MoneyInput @bind-Value="_shared.Price" Placeholder="@L["ui.amount"]" />
            }
            <button type="submit" class="btn btn--sm" disabled="@_busy">@L["ui.addPlus"]</button>
        </form>
        <div class="split-pick">
            <label class="check small"><input type="radio" name="split-@Meal.Id" checked="@_shared.SplitAll" @onchange="() => _shared.SplitAll = true" /> @L["meal.splitAll"]</label>
            <label class="check small"><input type="radio" name="split-@Meal.Id" checked="@(!_shared.SplitAll)" @onchange="() => _shared.SplitAll = false" /> @L["meal.splitSome"]</label>
            @if (!_shared.SplitAll)
            {
                @foreach (var p in Meal.Participants)
                {
                    var on = _shared.ParticipantIds.Contains(p.Id);
                    <label class="check small"><input type="checkbox" checked="@on" @onchange="e => ToggleSharedParticipant(p.Id, e.Value is true)" /> @p.Name</label>
                }
            }
        </div>
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired] public Meal Meal { get; set; } = default!;
    [Parameter] public List<Person> People { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<Meal> OnChangeRestaurant { get; set; }
    [Parameter] public EventCallback<Meal> OnDelete { get; set; }

    private sealed class ItemDraft
    {
        public string Name { get; set; } = "";
        public decimal? Price { get; set; }
        public int Qty { get; set; } = 1;
        public bool SaveToMenu { get; set; } = true;
    }

    private readonly Dictionary<long, ItemDraft> _drafts = new();
    private List<RestaurantItem> _menu = new();
    private List<SuggestInput.SuggestItem> _menuSuggest = new();
    private List<SuggestInput.SuggestItem> _peopleSuggest = new();
    private long _menuRestaurantId;
    private string _newName = "";
    private bool _saveToList = true;
    private bool _confirmDelete;
    private bool _busy;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _peopleSuggest = People.Select(p => new SuggestInput.SuggestItem(p.Name)).ToList();
        if (_menuRestaurantId != Meal.RestaurantId)
        {
            _menuRestaurantId = Meal.RestaurantId;
            await ReloadMenuAsync();
        }
    }

    private async Task ReloadMenuAsync()
    {
        _menu = await RestaurantSvc.GetItemsAsync(Meal.RestaurantId);
        _menuSuggest = _menu.Select(m => new SuggestInput.SuggestItem(m.Name, m.Price is null ? null : Money.Format(m.Price), m)).ToList();
    }

    /// <summary>Выбор позиции из подсказок: подставляет название и цену из меню.</summary>
    private void PickMenuItem(ItemDraft draft, SuggestInput.SuggestItem it)
    {
        draft.Name = it.Text;
        if (it.Tag is RestaurantItem { Price: { } price }) draft.Price = price;
    }

    private void PickSharedMenuItem(SuggestInput.SuggestItem it)
    {
        _shared.Name = it.Text;
        if (it.Tag is RestaurantItem { Price: { } price }) _shared.Price = price;
    }

    private ItemDraft DraftFor(long participantId)
    {
        if (!_drafts.TryGetValue(participantId, out var d))
            _drafts[participantId] = d = new ItemDraft();
        return d;
    }

    private RestaurantItem? FindMenuItem(string name) =>
        _menu.FirstOrDefault(m => string.Equals(m.Name, name.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Позиция уже есть в меню ресторана — галочка «в меню» не нужна.</summary>
    private bool IsMenuItem(ItemDraft draft) => FindMenuItem(draft.Name) is not null;


    private Task Run(Func<Task> action) => Run(async () => { await action(); return true; });

    private async Task Run(Func<Task<bool>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            if (await action())
                await OnChanged.InvokeAsync();
        }
        catch (ValidationException ex)
        {
            _error = L.Error(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task OnReceipt(InputFileChangeEventArgs e) => Run(() => Meals.AttachReceiptAsync(Meal.Id, e.File));

    private Task RemoveReceipt() => Run(() => Meals.RemoveReceiptAsync(Meal.Id));

    /// <summary>Имя совпадает с сохранённым человеком — галочка «сохранить в список» не нужна.</summary>
    private bool IsKnownPerson =>
        People.Any(p => string.Equals(p.Name, _newName.Trim(), StringComparison.OrdinalIgnoreCase));

    private Task AddParticipant() => Run(async () =>
    {
        await Meals.AddParticipantAsync(Meal.Id, _newName, _saveToList || IsKnownPerson);
        _newName = "";
    });

    private Task TogglePaid(MealParticipant p) => Run(() => Meals.SetParticipantPaidAsync(p.Id, !p.IsPaid));

    private Task RemoveParticipant(long id) => Run(async () =>
    {
        await Meals.RemoveParticipantAsync(id);
        _drafts.Remove(id);
    });

    private Task AddItem(long participantId) => Run(async () =>
    {
        var d = DraftFor(participantId);
        // Уже известная позиция меню не перезаписывается (галочка скрыта), как и у участников из списка.
        var saveToMenu = d.SaveToMenu && !IsMenuItem(d);
        await Meals.AddItemAsync(participantId, d.Name, d.Price, d.Qty, saveToMenu);
        if (saveToMenu) await ReloadMenuAsync();
        _drafts[participantId] = new ItemDraft { SaveToMenu = d.SaveToMenu };
    });

    private Task RemoveItem(long id) => Run(() => Meals.RemoveItemAsync(id));

    // ---- общие позиции и сборы ----

    private sealed class SharedDraft
    {
        public string Kind { get; set; } = "item";
        public string Name { get; set; } = "";
        public decimal? Price { get; set; }
        public int Qty { get; set; } = 1;
        public bool SplitAll { get; set; } = true;
        public bool SaveToMenu { get; set; } = true;
        public HashSet<long> ParticipantIds { get; } = new();
    }


    private SharedDraft _shared = new();

    private string KindTitle(string kind) => Meals.SharedKindTitle(kind);


    private string SplitText(SharedItem s)
    {
        if (s.SplitAll) return Meal.Participants.Count > 0 ? L.F("meal.splitAllN", Meal.Participants.Count) : L["meal.splitAll"];
        var names = Meal.Participants.Where(p => s.ParticipantIds.Contains(p.Id)).Select(p => p.Name).ToList();
        return names.Count == 0 ? L["meal.splitNone"] : L.F("meal.splitFor", string.Join(", ", names));
    }

    private void PickKind(string kind)
    {
        _shared.Kind = kind;
        if (kind != "item")
        {
            _shared.Name = KindTitle(kind);
            _shared.Qty = 1;
        }
        else if (MealService.SharedKinds.Any(k => k != "item" && _shared.Name == KindTitle(k)))
        {
            _shared.Name = "";
        }
    }

    /// <summary>Смена формата (доставка / на месте) меняет набор сборов; уже добавленные позиции остаются.</summary>
    private Task SetMode(string mode) => Run(async () =>
    {
        await Meals.SetModeAsync(Meal.Id, mode);
        if (!MealService.KindsFor(mode).Contains(_shared.Kind)) PickKind("item");
    });

    private void ToggleSharedParticipant(long id, bool on)
    {
        if (on) _shared.ParticipantIds.Add(id); else _shared.ParticipantIds.Remove(id);
    }

    private Task AddShared() => Run(async () =>
    {
        // известная позиция меню не перезаписывается (галочка скрыта), как и у личных позиций
        var saveToMenu = _shared.Kind == "item" && _shared.SaveToMenu && FindMenuItem(_shared.Name) is null;
        await Meals.AddSharedItemAsync(Meal.Id, _shared.Name, _shared.Kind, _shared.Price, _shared.Qty, _shared.SplitAll, _shared.ParticipantIds.ToList(), saveToMenu);
        if (saveToMenu) await ReloadMenuAsync();
        _shared = new SharedDraft();
    });

    private Task RemoveShared(long id) => Run(() => Meals.RemoveSharedItemAsync(id));
}
