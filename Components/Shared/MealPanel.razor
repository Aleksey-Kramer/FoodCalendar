@inject MealService Meals
@inject RestaurantService RestaurantSvc

<div class="meal">
    <div class="meal__head">
        <RestaurantThumb Name="@Meal.RestaurantName" ImageFile="@Meal.ImageFile" CssClass="thumb--row" />
        <div class="meal__title">
            @if (!Meal.IsMain)
            {
                <span class="chip">@Meal.Label</span>
            }
            <b>@Meal.RestaurantName</b>
            @if (!Meal.IsActive)
            {
                <span class="badge">неактивен</span>
            }
        </div>
        <div class="meal__actions">
            <button type="button" class="btn btn--sm" @onclick="() => OnChangeRestaurant.InvokeAsync(Meal)">Сменить ресторан</button>
            @if (_confirmDelete)
            {
                <span class="confirm">
                    Удалить вместе с чеком и участниками?
                    <button type="button" class="btn btn--sm btn--danger" @onclick="() => OnDelete.InvokeAsync(Meal)">Да</button>
                    <button type="button" class="btn btn--sm" @onclick="() => _confirmDelete = false">Нет</button>
                </span>
            }
            else
            {
                <button type="button" class="btn btn--sm btn--danger" @onclick="() => _confirmDelete = true">@(Meal.IsMain ? "Убрать" : "Удалить")</button>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert">@_error</div>
    }

    <div class="meal__grid">
        <div class="meal__receipt">
            <div class="field__label">Чек</div>
            @if (Meal.ReceiptFile is { } rf)
            {
                @if (ReceiptService.IsPdf(rf))
                {
                    <a class="btn btn--sm" href="@ReceiptService.Url(rf)" target="_blank">📄 Открыть PDF</a>
                }
                else
                {
                    <a href="@ReceiptService.Url(rf)" target="_blank" title="Открыть чек">
                        <img class="receipt__img" src="@ReceiptService.Url(rf)" alt="Чек" loading="lazy" />
                    </a>
                }
                <button type="button" class="btn btn--sm btn--danger" @onclick="RemoveReceipt" disabled="@_busy">Убрать чек</button>
            }
            else
            {
                <label class="btn btn--sm file-btn">
                    📎 Прикрепить чек
                    <InputFile OnChange="OnReceipt" accept="@ReceiptService.Accept" class="file-btn__input" />
                </label>
                <div class="muted small">Картинка или PDF, до 10 МБ</div>
            }

            <div class="field">
                <span class="field__label">Итого по чеку</span>
                <form class="inline-form total-form" data-arrow-nav @onsubmit="SaveTotal" @onsubmit:preventDefault="true">
                    <MoneyInput CssClass="input input--grow" @bind-Value="_total" @bind-Value:after="SaveTotal" Placeholder="0" />
                    <button type="submit" class="btn btn--sm btn--primary" disabled="@_busy">Сохранить</button>
                    @if (_totalSaved)
                    {
                        <span class="saved small">✓ Сохранено</span>
                    }
                </form>
            </div>
            <div class="small">
                Сумма позиций: <b>@Money.Format(Meal.ItemsTotal)</b>
                @if (Meal.SharedTotal > 0)
                {
                    <span class="muted"> (личные @Money.Format(Meal.OwnItemsTotal) + общие @Money.Format(Meal.SharedTotal))</span>
                }
                @if (Meal.TotalAmount is { } t && t != Meal.ItemsTotal)
                {
                    <span class="muted"> · разница с чеком: @Money.Format(t - Meal.ItemsTotal)</span>
                }
            </div>
        </div>

        <div class="meal__people">
            <div class="field__label">Участники</div>
            @if (Meal.Participants.Count == 0)
            {
                <p class="muted small">Пока никого.</p>
            }
            @foreach (var p in Meal.Participants)
            {
                var draft = DraftFor(p.Id);
                <div class="participant" @key="p.Id">
                    <div class="participant__head">
                        <b>@p.Name</b>
                        @if (Meal.SharedItems.Count > 0)
                        {
                            <span class="participant__totals">своё @Money.Format(p.Subtotal) + общее @Money.Format(Meal.ShareFor(p.Id))</span>
                        }
                        <span class="participant__sum" title="Итого с долей общих">@Money.Format(Meal.TotalFor(p))</span>
                        <button type="button" class="btn btn--icon btn--xs" title="Убрать участника" @onclick="() => RemoveParticipant(p.Id)">✕</button>
                    </div>
                    @if (p.Items.Count > 0)
                    {
                        <table class="items">
                            <tbody>
                            @foreach (var it in p.Items)
                            {
                                <tr @key="it.Id">
                                    <td class="items__name">@it.Name</td>
                                    <td class="items__num">@Money.Format(it.Price)</td>
                                    <td class="items__num">× @it.Qty</td>
                                    <td class="items__num"><b>@Money.Format((it.Price ?? 0) * it.Qty)</b></td>
                                    <td class="items__act"><button type="button" class="btn btn--icon btn--xs" title="Удалить позицию" @onclick="() => RemoveItem(it.Id)">✕</button></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    <form class="inline-form inline-form--wrap" data-arrow-nav @onsubmit="() => AddItem(p.Id)" @onsubmit:preventDefault="true">
                        <input class="input input--grow" list="menu-@Meal.Id" @bind="draft.Name" @bind:event="oninput" @bind:after="() => AutoPrice(draft)" maxlength="100" placeholder="Позиция" />
                        <MoneyInput @bind-Value="draft.Price" Placeholder="Цена" />
                        <input class="input input--qty" type="number" min="1" max="99" @bind="draft.Qty" title="Количество" />
                        @if (!IsMenuItem(draft))
                        {
                            <label class="check small" title="Сохранить позицию и цену в меню ресторана"><input type="checkbox" @bind="draft.SaveToMenu" /> в меню</label>
                        }
                        <button type="submit" class="btn btn--sm" disabled="@_busy">+ Позиция</button>
                    </form>
                </div>
            }

            <form class="inline-form inline-form--wrap participant-add" data-arrow-nav @onsubmit="AddParticipant" @onsubmit:preventDefault="true">
                <input class="input input--grow" list="people-list" @bind="_newName" @bind:event="oninput" maxlength="60" placeholder="Имя участника" />
                @if (!IsKnownPerson)
                {
                    <label class="check small"><input type="checkbox" @bind="_saveToList" /> сохранить в список</label>
                }
                <button type="submit" class="btn btn--sm btn--primary" disabled="@_busy">+ Участник</button>
            </form>
        </div>
    </div>

    <div class="shared">
        <div class="shared__head">
            <span class="field__label" style="margin:0">Общие позиции и сборы</span>
            <span class="shared__sum">@Money.Format(Meal.SharedTotal)</span>
        </div>
        @if (Meal.SharedItems.Count > 0)
        {
            <table class="items">
                <tbody>
                @foreach (var s in Meal.SharedItems)
                {
                    <tr @key="s.Id">
                        <td class="items__name">
                            @s.Name
                            <div class="shared__split">@KindTitle(s.Kind) · @SplitText(s)</div>
                        </td>
                        <td class="items__num">@(s.Qty > 1 ? $"{Money.Format(s.Price)} × {s.Qty}" : "")</td>
                        <td class="items__num"><b>@Money.Format(s.Amount)</b></td>
                        <td class="items__act"><button type="button" class="btn btn--icon btn--xs" title="Удалить" @onclick="() => RemoveShared(s.Id)">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
        }
        <div class="quick">
            @foreach (var (kind, title) in MealService.SharedKinds)
            {
                <button type="button" class="btn btn--sm @(_shared.Kind == kind ? "btn--primary" : "")" @onclick="() => PickKind(kind, title)">@title</button>
            }
        </div>
        <form class="inline-form inline-form--wrap" data-arrow-nav @onsubmit="AddShared" @onsubmit:preventDefault="true" style="margin-top:8px">
            <input class="input input--grow" @bind="_shared.Name" maxlength="100" placeholder="@(_shared.Kind == "item" ? "Соус, упаковка, пакет…" : KindTitle(_shared.Kind))" />
            <MoneyInput @bind-Value="_shared.Price" Placeholder="Сумма" />
            @if (_shared.Kind == "item")
            {
                <input class="input input--qty" type="number" min="1" max="99" @bind="_shared.Qty" title="Количество" />
            }
            <button type="submit" class="btn btn--sm" disabled="@_busy">+ Добавить</button>
        </form>
        <div class="split-pick">
            <label class="check small"><input type="radio" name="split-@Meal.Id" checked="@_shared.SplitAll" @onchange="() => _shared.SplitAll = true" /> на всех</label>
            <label class="check small"><input type="radio" name="split-@Meal.Id" checked="@(!_shared.SplitAll)" @onchange="() => _shared.SplitAll = false" /> на выбранных:</label>
            @if (!_shared.SplitAll)
            {
                @foreach (var p in Meal.Participants)
                {
                    var on = _shared.ParticipantIds.Contains(p.Id);
                    <label class="check small"><input type="checkbox" checked="@on" @onchange="e => ToggleSharedParticipant(p.Id, e.Value is true)" /> @p.Name</label>
                }
            }
        </div>
    </div>

    <datalist id="menu-@Meal.Id">
        @foreach (var mi in _menu)
        {
            <option value="@mi.Name">@(mi.Price is null ? "" : Money.Format(mi.Price))</option>
        }
    </datalist>
</div>

@code {
    [Parameter, EditorRequired] public Meal Meal { get; set; } = default!;
    [Parameter] public List<Person> People { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<Meal> OnChangeRestaurant { get; set; }
    [Parameter] public EventCallback<Meal> OnDelete { get; set; }

    private sealed class ItemDraft
    {
        public string Name { get; set; } = "";
        public decimal? Price { get; set; }
        public int Qty { get; set; } = 1;
        public bool SaveToMenu { get; set; } = true;
    }

    private readonly Dictionary<long, ItemDraft> _drafts = new();
    private List<RestaurantItem> _menu = new();
    private long _menuRestaurantId;
    private decimal? _total;
    private bool _totalSaved;
    private string _newName = "";
    private bool _saveToList = true;
    private bool _confirmDelete;
    private bool _busy;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _total = Meal.TotalAmount;
        if (_menuRestaurantId != Meal.RestaurantId)
        {
            _menuRestaurantId = Meal.RestaurantId;
            _menu = await RestaurantSvc.GetItemsAsync(Meal.RestaurantId);
        }
    }

    private ItemDraft DraftFor(long participantId)
    {
        if (!_drafts.TryGetValue(participantId, out var d))
            _drafts[participantId] = d = new ItemDraft();
        return d;
    }

    private RestaurantItem? FindMenuItem(string name) =>
        _menu.FirstOrDefault(m => string.Equals(m.Name, name.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Позиция уже есть в меню ресторана — галочка «в меню» не нужна.</summary>
    private bool IsMenuItem(ItemDraft draft) => FindMenuItem(draft.Name) is not null;

    /// <summary>Подставляет цену из меню ресторана, если название совпало.</summary>
    private void AutoPrice(ItemDraft draft)
    {
        if (FindMenuItem(draft.Name)?.Price is { } price) draft.Price = price;
    }

    private Task Run(Func<Task> action) => Run(async () => { await action(); return true; });

    private async Task Run(Func<Task<bool>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            if (await action())
                await OnChanged.InvokeAsync();
        }
        catch (ValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Сохраняется и при уходе из поля, и по кнопке «Сохранить» — кнопка показывает отметку.</summary>
    private Task SaveTotal() => Run(async () =>
    {
        await Meals.SetTotalAsync(Meal.Id, _total);
        _totalSaved = true;
    });

    private Task OnReceipt(InputFileChangeEventArgs e) => Run(() => Meals.AttachReceiptAsync(Meal.Id, e.File));

    private Task RemoveReceipt() => Run(() => Meals.RemoveReceiptAsync(Meal.Id));

    /// <summary>Имя совпадает с сохранённым человеком — галочка «сохранить в список» не нужна.</summary>
    private bool IsKnownPerson =>
        People.Any(p => string.Equals(p.Name, _newName.Trim(), StringComparison.OrdinalIgnoreCase));

    private Task AddParticipant() => Run(async () =>
    {
        await Meals.AddParticipantAsync(Meal.Id, _newName, _saveToList || IsKnownPerson);
        _newName = "";
    });

    private Task RemoveParticipant(long id) => Run(async () =>
    {
        await Meals.RemoveParticipantAsync(id);
        _drafts.Remove(id);
    });

    private Task AddItem(long participantId) => Run(async () =>
    {
        var d = DraftFor(participantId);
        // Уже известная позиция меню не перезаписывается (галочка скрыта), как и у участников из списка.
        var saveToMenu = d.SaveToMenu && !IsMenuItem(d);
        await Meals.AddItemAsync(participantId, d.Name, d.Price, d.Qty, saveToMenu);
        if (saveToMenu) _menu = await RestaurantSvc.GetItemsAsync(Meal.RestaurantId);
        _drafts[participantId] = new ItemDraft { SaveToMenu = d.SaveToMenu };
    });

    private Task RemoveItem(long id) => Run(() => Meals.RemoveItemAsync(id));

    // ---- общие позиции и сборы ----

    private sealed class SharedDraft
    {
        public string Kind { get; set; } = "item";
        public string Name { get; set; } = "";
        public decimal? Price { get; set; }
        public int Qty { get; set; } = 1;
        public bool SplitAll { get; set; } = true;
        public HashSet<long> ParticipantIds { get; } = new();
    }

    private SharedDraft _shared = new();

    private static string KindTitle(string kind) =>
        MealService.SharedKinds.FirstOrDefault(k => k.Kind == kind).Title ?? kind;

    private string SplitText(SharedItem s)
    {
        if (s.SplitAll) return Meal.Participants.Count > 0 ? $"на всех ({Meal.Participants.Count})" : "на всех";
        var names = Meal.Participants.Where(p => s.ParticipantIds.Contains(p.Id)).Select(p => p.Name).ToList();
        return names.Count == 0 ? "ни на кого (участники удалены)" : "на: " + string.Join(", ", names);
    }

    private void PickKind(string kind, string title)
    {
        _shared.Kind = kind;
        if (kind != "item")
        {
            _shared.Name = title;
            _shared.Qty = 1;
        }
        else if (_shared.Name == "Доставка" || _shared.Name == "Работа сервиса")
        {
            _shared.Name = "";
        }
    }

    private void ToggleSharedParticipant(long id, bool on)
    {
        if (on) _shared.ParticipantIds.Add(id); else _shared.ParticipantIds.Remove(id);
    }

    private Task AddShared() => Run(async () =>
    {
        await Meals.AddSharedItemAsync(Meal.Id, _shared.Name, _shared.Kind, _shared.Price, _shared.Qty, _shared.SplitAll, _shared.ParticipantIds.ToList());
        _shared = new SharedDraft();
    });

    private Task RemoveShared(long id) => Run(() => Meals.RemoveSharedItemAsync(id));
}
