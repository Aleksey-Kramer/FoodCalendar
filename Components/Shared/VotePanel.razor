@implements IDisposable
@inject VoteService Votes
@inject RestaurantService RestaurantSvc
@inject ChangeNotifier Notifier
@inject IJSRuntime JS

<section class="vote">
    <div class="section__head">
        <h2>Голосование <span class="muted small">на сегодня или на будущий рабочий день</span></h2>
    </div>

    @if (_loading)
    {
        <p class="muted">Загрузка…</p>
    }
    else
    {
        <div class="vote__name">
            <label class="field">
                <span class="field__label">Ваше имя</span>
                <input class="input" list="people-list-vote" @bind="_name" @bind:after="SaveName" maxlength="60" placeholder="Как вас называть в голосовании" />
            </label>
        </div>

        @foreach (var f in _board.Finished.Where(f => _board.Open.All(o => o.Date != f.Date)))
        {
            <p class="vote__result" @key="f.Id">
                🏆 @(f.DateValue == CalendarService.Today ? "Сегодня" : CalendarService.FormatLong(f.DateValue)): победил <b>@f.WinnerName</b> (раунд @f.Round), ресторан добавлен в календарь.
            </p>
        }

        @foreach (var v in _board.Open)
        {
            <VoteCard @key="v.Id" Vote="v" Name="@_name" Active="_active" OnChanged="LoadAndRender" />
        }

        @if (_board.Open.Count == 0 && _board.Finished.Count == 0)
        {
            <p class="muted small">Активных голосований нет.</p>
        }

        @if (!_starting)
        {
            <button type="button" class="btn btn--primary" @onclick="BeginStart">Начать голосование</button>
        }
        else
        {
            <div class="vote__start">
                <label class="field vote__date">
                    <span class="field__label">На какой день</span>
                    <input type="date" class="input" min="@CalendarService.Key(CalendarService.Today)" @bind="_startDate" />
                </label>
                <p class="muted small">Только сегодня или будущие рабочие дни. Отметьте минимум два ресторана и нажмите «Начать» — остальные увидят голосование и присоединятся.</p>
                @if (_error is not null)
                {
                    <div class="alert">@_error</div>
                }
                <div class="vote__options">
                    @foreach (var r in _active)
                    {
                        var on = _startIds.Contains(r.Id);
                        <label class="vote__option @(on ? "vote__option--on" : "")" @key="r.Id">
                            <input type="checkbox" checked="@on" @onchange="e => ToggleStart(r.Id, e.Value is true)" />
                            <RestaurantThumb Name="@r.Name" ImageFile="@r.ImageFile" CssClass="thumb--cell" />
                            <span class="vote__option-name">@r.Name</span>
                        </label>
                    }
                </div>
                <div class="vote__actions">
                    <button type="button" class="btn btn--primary" disabled="@_busy" @onclick="Start">Начать</button>
                    <button type="button" class="btn" @onclick="() => { _starting = false; _error = null; }">Отмена</button>
                </div>
            </div>
        }
    }
</section>

<datalist id="people-list-vote">
    @foreach (var n in KnownNames) { <option value="@n" /> }
</datalist>

@code {
    /// <summary>Вызывается, когда какое-то голосование завершилось и победитель попал в календарь.</summary>
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public List<string> KnownNames { get; set; } = new();

    private VoteBoard _board = new();
    private List<Restaurant> _active = new();
    private readonly HashSet<long> _startIds = new();
    private string _name = "";
    private DateOnly _startDate = VoteService.DefaultDate();
    private bool _starting;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private int _finishedSeen;

    protected override void OnInitialized() => Notifier.Changed += OnChangedAsync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _name = await JS.InvokeAsync<string>("userName.get") ?? ""; }
        catch (JSException) { }
        await LoadAsync();
        _finishedSeen = _board.Finished.Count;
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _active = await RestaurantSvc.GetActiveAsync();
        _board = await Votes.GetBoardAsync();
    }

    private async Task LoadAndRender()
    {
        await LoadAsync();
        await NotifyCompletedAsync();
    }

    private async Task NotifyCompletedAsync()
    {
        if (_board.Finished.Count > _finishedSeen)
            await OnCompleted.InvokeAsync();
        _finishedSeen = _board.Finished.Count;
    }

    private Task OnChangedAsync() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
        await NotifyCompletedAsync();
    });

    private async Task SaveName()
    {
        try { await JS.InvokeVoidAsync("userName.set", _name.Trim()); } catch (JSException) { }
    }

    private void BeginStart()
    {
        _startDate = VoteService.DefaultDate();
        _error = null;
        _starting = true;
    }

    private void ToggleStart(long restaurantId, bool on) { if (on) _startIds.Add(restaurantId); else _startIds.Remove(restaurantId); }

    private async Task Start()
    {
        _busy = true;
        _error = null;
        try
        {
            await Votes.StartAsync(_name, _startIds.ToList(), _startDate);
            _starting = false;
            _startIds.Clear();
            await LoadAsync();
        }
        catch (ValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => Notifier.Changed -= OnChangedAsync;
}
