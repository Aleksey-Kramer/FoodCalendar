<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FoodCalendar</RootNamespace>
    <AssemblyName>FoodCalendar</AssemblyName>
    <!-- рантайм-папка с БД и картинками не входит в проект -->
    <DefaultItemExcludes>$(DefaultItemExcludes);storage/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="Data\SeedImages\*.png" LogicalName="seed/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
